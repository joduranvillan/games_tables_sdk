; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenTable — 13 Classic Board & Card Games"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("26.2", "Redot")
boot_splash/image="res://assets/icons/opentable_suite.svg"
config/icon="res://assets/icons/opentable_suite.svg"

[autoload]

ErrorLogger="*res://error_logger.gd"
TranslationLoader="*res://translation_loader.gd"
GameManager="*res://game_manager.gd"
ThemeManager="*res://theme_manager.gd"
SceneManager="*res://scene_manager.gd"
AudioManager="*res://audio_manager.gd"
ScoreTracker="*res://score_tracker.gd"
AchievementManager="*res://achievement_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
SteamManager="*res://scripts/steam_manager.gd"
TutorialManager="*res://scripts/tutorial_manager.gd"
AuthClient="*res://scripts/auth_client.gd"
GamepadBoardCursor="*res://scripts/gamepad_board_cursor.gd"
HapticsManager="*res://scripts/haptics_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[locale]

translations=PackedStringArray("res://assets/translations/translations.csv", "res://assets/translations/translations.en.translation", "res://assets/translations/translations.es.translation", "res://assets/translations/translations.pt.translation", "res://assets/translations/translations.fr.translation")
locale_filter_mode=1
locales_filter=PackedStringArray("en", "es", "pt", "fr")

[input]

ui_gamepad_up={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":11,"pressure":0.0,"pressed":false,"script":null), Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":-1.0,"script":null)]
}
