; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenTable — Damas"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("26.2", "Redot")
boot_splash/image="res://assets/icons/checkers.svg"
config/icon="res://assets/icons/checkers.svg"

[autoload]

ErrorLogger="*res://error_logger.gd"
TranslationLoader="*res://translation_loader.gd"
GameManager="*res://game_manager.gd"
ThemeManager="*res://theme_manager.gd"
SceneManager="*res://scene_manager.gd"
AudioManager="*res://audio_manager.gd"
ScoreTracker="*res://score_tracker.gd"
AchievementManager="*res://achievement_manager.gd"
SaveManager="*res://scripts/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[locale]

translations=PackedStringArray("res://assets/translations/translations.csv", "res://assets/translations/translations.en.translation", "res://assets/translations/translations.es.translation", "res://assets/translations/translations.pt.translation", "res://assets/translations/translations.fr.translation")
locale_filter_mode=1
locales_filter=PackedStringArray("en", "es", "pt", "fr")

