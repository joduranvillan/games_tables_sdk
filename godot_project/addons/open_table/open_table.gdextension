[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = false

[libraries]
linux.debug.x86_64 = "res://addons/open_table/bin/linux/libopen_table_godot.so"
linux.release.x86_64 = "res://addons/open_table/bin/linux/libopen_table_godot.so"
linux.debug.arm64 = "res://addons/open_table/bin/linux/libopen_table_godot_arm64.so"
linux.release.arm64 = "res://addons/open_table/bin/linux/libopen_table_godot_arm64.so"
windows.debug.x86_64 = "res://addons/open_table/bin/windows/open_table_godot.dll"
windows.release.x86_64 = "res://addons/open_table/bin/windows/open_table_godot.dll"
windows.debug.arm64 = "res://addons/open_table/bin/windows/open_table_godot_arm64.dll"
windows.release.arm64 = "res://addons/open_table/bin/windows/open_table_godot_arm64.dll"
macos.debug = "res://addons/open_table/bin/macos/libopen_table_godot.dylib"
macos.release = "res://addons/open_table/bin/macos/libopen_table_godot.dylib"
macos.debug.x86_64 = "res://addons/open_table/bin/macos/libopen_table_godot_x86_64.dylib"
macos.release.x86_64 = "res://addons/open_table/bin/macos/libopen_table_godot_x86_64.dylib"
macos.debug.arm64 = "res://addons/open_table/bin/macos/libopen_table_godot_arm64.dylib"
macos.release.arm64 = "res://addons/open_table/bin/macos/libopen_table_godot_arm64.dylib"
android.debug.arm64 = "res://addons/open_table/bin/android/arm64-v8a/libopen_table_godot.so"
android.release.arm64 = "res://addons/open_table/bin/android/arm64-v8a/libopen_table_godot.so"
android.debug.aarch64 = "res://addons/open_table/bin/android/arm64-v8a/libopen_table_godot.so"
android.release.aarch64 = "res://addons/open_table/bin/android/arm64-v8a/libopen_table_godot.so"
android.debug.x86_64 = "res://addons/open_table/bin/android/x86_64/libopen_table_godot.so"
android.release.x86_64 = "res://addons/open_table/bin/android/x86_64/libopen_table_godot.so"
ios.debug.arm64 = "res://addons/open_table/bin/ios/libopen_table_godot.dylib"
ios.release.arm64 = "res://addons/open_table/bin/ios/libopen_table_godot.dylib"
web.debug.threads.wasm32 = "res://addons/open_table/bin/web/open_table_godot.wasm"
web.release.threads.wasm32 = "res://addons/open_table/bin/web/open_table_godot.wasm"
web.debug.wasm32 = "res://addons/open_table/bin/web/open_table_godot.wasm"
web.release.wasm32 = "res://addons/open_table/bin/web/open_table_godot.wasm"

[dependencies]
android.debug.arm64 = {
	"res://../platform_plugins/android/OpenTableNearby.gdap": ""
}
android.release.arm64 = {
	"res://../platform_plugins/android/OpenTableNearby.gdap": ""
}
android.release.x86_64 = {
	"res://../platform_plugins/android/OpenTableNearby.gdap": ""
}
ios.debug.arm64 = {
	"res://../platform_plugins/ios/OpenTableMultipeer.gdip": ""
}
ios.release.arm64 = {
	"res://../platform_plugins/ios/OpenTableMultipeer.gdip": ""
}
